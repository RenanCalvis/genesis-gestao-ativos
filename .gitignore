# =========================
# BANCO DE DADOS E INFRA
# =========================
/storage/

# =========================
# SISTEMA OPERACIONAL E IDE
# =========================
.DS_Store
._*
.idea/
.vscode/

# =========================
# CODEIGNITER 4 (Pasta /app)
# =========================
/app/.env
/app/php_errors.log
/app/phpunit*.xml
/app/vendor/

# Ignorar arquivos temporários do CI4, mantendo apenas os index.html de segurança
/app/writable/cache/*
!/app/writable/cache/index.html

/app/writable/logs/*
!/app/writable/logs/index.html

/app/writable/session/*
!/app/writable/session/index.html

/app/writable/uploads/*
!/app/writable/uploads/index.html

/app/writable/debugbar/*
!/app/writable/debugbar/index.html